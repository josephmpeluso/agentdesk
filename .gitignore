# Secrets — never commit an API key
.env
.env.*
*.env
*.key
**/secrets/**

# Python
__pycache__/
*.pyc
.venv/
venv/

# Netlify CLI local site-link state — machine-specific, not for version control
.netlify/

# Wrangler (Cloudflare Pages) local cache — machine-specific, not for version control
.wrangler/

# Generated on every run — never commit
runs.jsonl

# OS cruft
.DS_Store
Thumbs.db

# Local scratch — throwaway debug/test scripts, never meant to be committed
_debug_*.py
_debug_*.txt
_test_*.py
_test_*.jsonl
*.log
