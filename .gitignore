# Secrets — never commit an API key
.env
.env.*
*.key
**/secrets/**

# Python
__pycache__/
*.pyc
.venv/
venv/

# Netlify CLI local site-link state — machine-specific, not for version control
.netlify/

# Local scratch — throwaway debug/test scripts, never meant to be committed
_debug_*.py
_debug_*.txt
_test_*.py
_test_*.jsonl
*.log
